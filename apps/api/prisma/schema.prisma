// Schema v1 (week 2). Based on the MVP report's draft, see docs/adr/0006.
// Conventions: tables and multi-word columns are snake_case in PostgreSQL;
// money is stored in kuruş (Int) and mapped to TL numbers in the API;
// image fields hold object keys, the API turns them into URLs.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum OtpPurpose {
  EMAIL_VERIFY
  PHONE_VERIFY
  PASSWORD_RESET
}

enum LightLevel {
  LOW
  PARTIAL
  BRIGHT_INDIRECT
  DIRECT
}

enum Difficulty {
  NO_FUSS
  EASY
  MODERATE
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  passwordHash  String         @map("password_hash") // Argon2id
  phoneNumber   String?        @unique @map("phone_number")
  location      String?
  emailVerified Boolean        @default(false) @map("email_verified")
  phoneVerified Boolean        @default(false) @map("phone_verified")
  role          Role           @default(CUSTOMER)
  createdAt     DateTime       @default(now()) @map("created_at")
  // Account deletion blanks personal fields and deletes the user's plants,
  // scans, photos and chats.
  anonymizedAt  DateTime?      @map("anonymized_at")
  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]
  consents      Consent[]
  // AI plant app (from week 5 of the new plan)
  // Stable id for third parties (RevenueCat app_user_id); never the row id.
  publicId      String         @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  userPlants    UserPlant[]
  scans         Scan[]
  chatMessages  ChatMessage[]
  entitlement   Entitlement?

  @@map("users")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") // SHA-256, never the raw token
  familyId  String    @map("family_id") // reuse revokes the whole family
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model OtpCode {
  id         Int        @id @default(autoincrement())
  userId     Int?       @map("user_id")
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  target     String // e-mail or +90...
  purpose    OtpPurpose
  codeHash   String     @map("code_hash")
  attempts   Int        @default(0) // at most 5
  expiresAt  DateTime   @map("expires_at") // 10 minutes
  consumedAt DateTime?  @map("consumed_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([target, purpose])
  @@map("otp_codes")
}

model Supplier {
  id            Int     @id @default(autoincrement())
  name          String  @unique
  city          String?
  producerRegNo String? @map("producer_reg_no") // producer registration number
  plants        Plant[]

  @@map("suppliers")
}

model Plant {
  id            Int          @id @default(autoincrement())
  // Every size is its own record: "Monstera Deliciosa 40-50 cm".
  slug          String       @unique
  name          String
  latinName     String?      @map("latin_name")
  description   String
  priceKurus    Int          @map("price_kurus")
  oldPriceKurus Int?         @map("old_price_kurus")
  stock         Int          @default(0)
  heightMinCm   Int?         @map("height_min_cm")
  heightMaxCm   Int?         @map("height_max_cm")
  light         LightLevel?
  difficulty    Difficulty?
  petSafe       Boolean?     @map("pet_safe")
  airPurifying  Boolean?     @map("air_purifying")
  wateringNote  String?      @map("watering_note") // Turkish care card
  istanbulOnly  Boolean      @default(false) @map("istanbul_only")
  isBestSeller  Boolean      @default(false) @map("is_best_seller")
  isFeatured    Boolean      @default(false) @map("is_featured")
  isNew         Boolean      @default(false) @map("is_new")
  isTop         Boolean      @default(false) @map("is_top")
  // Legacy match key against Slide/Banner.promotion.
  promotion     String?
  ratingAvg     Float        @default(0) @map("rating_avg") // "rating" on the wire
  ratingCount   Int          @default(0) @map("rating_count")
  active        Boolean      @default(true)
  passportNo    String?      @map("passport_no") // plant passport, if in scope
  supplierId    Int?         @map("supplier_id")
  supplier      Supplier?    @relation(fields: [supplierId], references: [id])
  images        PlantImage[]
  categories    Category[]
  colors        Color[]
  potTypes      PotType[]
  plantTypes    PlantType[]
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([active, stock])
  @@map("plants")
}

model PlantImage {
  id      Int    @id @default(autoincrement())
  plantId Int    @map("plant_id")
  plant   Plant  @relation(fields: [plantId], references: [id], onDelete: Cascade)
  key     String // object key; the API builds the URL
  sort    Int    @default(0)

  @@index([plantId, sort])
  @@map("plant_images")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  image     String? // object key
  sort      Int      @default(0)
  plants    Plant[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("categories")
}

model Color {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  code   String // hex; the app uses it as backgroundColor
  plants Plant[]

  @@map("colors")
}

model PotType {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  plants Plant[]

  @@map("pot_types")
}

model PlantType {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  plants Plant[]

  @@map("plant_types")
}

model Slide {
  id         Int     @id @default(autoincrement())
  image      String // object key
  promotion  String?
  titleLine1 String  @map("title_line_1")
  titleLine2 String  @map("title_line_2")
  sort       Int     @default(0)
  active     Boolean @default(true)

  @@map("slides")
}

model Banner {
  id           Int     @id @default(autoincrement())
  title        String
  title1       String?
  title2       String?
  image        String // object key
  btnText      String? @map("btn_text")
  promotion    String?
  description1 String?
  description2 String?
  sort         Int     @default(0)
  active       Boolean @default(true)

  @@map("banners")
}

model Consent {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String // KVKK_AYDINLATMA | PAZARLAMA
  granted     Boolean
  textVersion String    @map("text_version")
  iysSyncedAt DateTime? @map("iys_synced_at") // marketing consent to İYS
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("consents")
}

// ---------------------------------------------------------------------------
// AI plant care app. Care and information first: species care cards, the
// user's plants, care log, scans (identification, diagnosis), the care
// assistant and the subscription entitlement. No product sales.
// ---------------------------------------------------------------------------

enum PlantSpot {
  INDOOR
  BALCONY
  GARDEN
}

enum CareKind {
  WATER
  FERTILIZE
  REPOT
  PRUNE
  MIST
  NOTE
}

enum ScanKind {
  IDENTIFY
  DIAGNOSE
}

enum ScanStatus {
  DONE
  FAILED
}

enum ChatRole {
  USER
  ASSISTANT
}

enum EntitlementStatus {
  ACTIVE
  GRACE // billing issue, access kept until the store gives up
  EXPIRED
}

// Care card per species, in Turkish. Draft data must be checked by a
// horticulturist before launch (see seed `reviewed`).
model PlantSpecies {
  id              Int         @id @default(autoincrement())
  scientificName  String      @unique @map("scientific_name")
  turkishName     String      @map("turkish_name")
  otherNames      String[]    @map("other_names")
  // Scientific synonyms and genus-level matches for identification results
  // ("Sansevieria trifasciata" for Dracaena trifasciata, "Calathea").
  synonyms        String[]    @default([])
  family          String?
  light           LightLevel
  difficulty      Difficulty
  // Days between waterings; the app shortens it in summer, lengthens it in
  // winter and for balcony plants by weather (later weeks).
  waterSummerDays Int         @map("water_summer_days")
  waterWinterDays Int         @map("water_winter_days")
  humidity        String // "düşük" | "orta" | "yüksek"
  tempMinC        Int         @map("temp_min_c")
  tempMaxC        Int         @map("temp_max_c")
  toxicToPets     Boolean?    @map("toxic_to_pets") // null = unknown
  toxicityNote    String?     @map("toxicity_note")
  summary         String
  wateringTip     String      @map("watering_tip")
  lightTip        String      @map("light_tip")
  fertilizingTip  String      @map("fertilizing_tip")
  commonProblems  String[]    @map("common_problems")
  spots           PlantSpot[] // where it does well
  source          String // where the facts come from
  reviewed        Boolean     @default(false) // checked by an expert
  userPlants      UserPlant[]
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@map("plant_species")
}

model UserPlant {
  id                   Int           @id @default(autoincrement())
  userId               Int           @map("user_id")
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  speciesId            Int?          @map("species_id")
  species              PlantSpecies? @relation(fields: [speciesId], references: [id])
  // Name from identification when the species has no care card yet.
  scientificName       String?       @map("scientific_name")
  nickname             String
  spot                 PlantSpot     @default(INDOOR)
  photoKey             String?       @map("photo_key")
  wateringIntervalDays Int           @map("watering_interval_days")
  lastWateredAt        DateTime?     @map("last_watered_at")
  archivedAt           DateTime?     @map("archived_at")
  careEvents           CareEvent[]
  scans                Scan[]
  chatMessages         ChatMessage[]
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@map("user_plants")
}

model CareEvent {
  id          Int       @id @default(autoincrement())
  userPlantId Int       @map("user_plant_id")
  userPlant   UserPlant @relation(fields: [userPlantId], references: [id], onDelete: Cascade)
  kind        CareKind
  note        String?
  at          DateTime  @default(now())

  @@index([userPlantId, at])
  @@map("care_events")
}

model Scan {
  id          Int        @id @default(autoincrement())
  userId      Int        @map("user_id")
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userPlantId Int?       @map("user_plant_id") // diagnosis of one of my plants
  userPlant   UserPlant? @relation(fields: [userPlantId], references: [id], onDelete: SetNull)
  kind        ScanKind
  status      ScanStatus
  imageKey    String     @map("image_key")
  provider    String // "fake" | "kindwise"
  // Normalized result shown to the user (never chemical treatments).
  result      Json?
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("scans")
}

model ChatMessage {
  id          Int        @id @default(autoincrement())
  userId      Int        @map("user_id")
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userPlantId Int?       @map("user_plant_id")
  userPlant   UserPlant? @relation(fields: [userPlantId], references: [id], onDelete: Cascade)
  role        ChatRole
  content     String
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([userId, userPlantId, createdAt])
  @@map("chat_messages")
}

// Current access per user, written only from verified billing events.
model Entitlement {
  id          Int               @id @default(autoincrement())
  userId      Int               @unique @map("user_id")
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      EntitlementStatus
  productId   String            @map("product_id")
  store       String // APP_STORE | PLAY_STORE | PROMOTIONAL ...
  sandbox     Boolean           @default(false)
  expiresAt   DateTime?         @map("expires_at")
  willRenew   Boolean           @default(true) @map("will_renew")
  // Events older than the last applied one are ignored (out-of-order delivery).
  lastEventAt DateTime          @map("last_event_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@map("entitlements")
}

// Every billing webhook, once (idempotency), with what we did with it.
model BillingEvent {
  id         Int      @id @default(autoincrement())
  provider   String // "revenuecat"
  eventId    String   @map("event_id")
  type       String
  appUserId  String?  @map("app_user_id")
  outcome    String // applied | ignored_old | unknown_user | skipped
  payload    Json
  receivedAt DateTime @default(now()) @map("received_at")

  @@unique([provider, eventId])
  @@map("billing_events")
}
