# Yerel geliştirme (Homebrew PostgreSQL). USER yerine `whoami` çıktısını yazın;
# Prisma şema motoru kullanıcı adı olmayan adresi kabul etmiyor.
# e2e testleri aynı adresin _test sonekli veritabanını kullanır (everbloom_test).
DATABASE_URL="postgresql://USER@localhost:5432/everbloom_dev?schema=public"
PORT=4100
NODE_ENV=development
LOG_LEVEL=info

# Görsel anahtarları bu adrese eklenir. Geliştirmede API görselleri
# LOCAL_ASSET_DIR klasöründen /images altında kendisi sunar; üretimde R2/CDN adresi.
# Gerçek telefonda localhost yerine bilgisayarın LAN IP adresini yazın.
ASSET_BASE_URL=http://localhost:4100/images
LOCAL_ASSET_DIR=../../packages/contract/mock/public/images

# Oturumlar. JWT_SECRET en az 32 karakter; üretmek için: openssl rand -base64 48
JWT_SECRET=buraya-en-az-32-karakterlik-rastgele-bir-deger-yazin
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Giriş, kayıt ve oturum yenileme için IP başına dakikalık istek sınırı
AUTH_RATE_LIMIT=10

# Doğrulama kodları. Geliştirmede "log": SMS ve e-posta gönderilmez, kod API
# logunda görünür. Üretimde "log" yasak; uygulama açılmaz.
SMS_DRIVER=log
# SMS_DRIVER=netgsm için (OTP paketi tanımlı Netgsm hesabı gerekir):
# NETGSM_USERCODE=
# NETGSM_PASSWORD=
# NETGSM_MSGHEADER=
EMAIL_DRIVER=log
# EMAIL_DRIVER=smtp için, örnek: smtps://kullanici:parola@smtp.saglayici.com:465
# SMTP_URL=
EMAIL_FROM=EverBloom <no-reply@everbloom.test>

# Yapay zekâ ile bakım. Geliştirmede "fake" sürücüler anahtarsız çalışır;
# üretimde yasak, uygulama açılmaz.
VISION_DRIVER=fake
# VISION_DRIVER=kindwise için: KINDWISE_API_KEY=
ASSISTANT_DRIVER=fake
# ASSISTANT_DRIVER=anthropic için: ANTHROPIC_API_KEY=
# Varsayılan claude-opus-5-5; daha ucuz seçenek: claude-haiku-5-5
# ASSISTANT_MODEL=claude-opus-5-5
# Tarama fotoğrafları (kişisel veri). Sunucu her fotoğrafı EXIF'siz JPEG'e çevirip saklar.
# Geliştirmede yerel klasör (git dışında); üretimde gizli bir Cloudflare R2 kovası zorunlu.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# STORAGE_DRIVER=r2 için:
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Ücretsiz plan ve premium adil kullanım sınırları (docs/kapsam.md)
# FREE_IDENTIFY_PER_WEEK=3
# FREE_DIAGNOSES=1
# FREE_MESSAGES_PER_MONTH=10
# FREE_PLANTS=5
# PREMIUM_SCANS_PER_DAY=50
# PREMIUM_MESSAGES_PER_MONTH=300
# RevenueCat webhook'unun yetki başlığı (Bearer <sır>); üretimde zorunlu
# REVENUECAT_WEBHOOK_SECRET=
# Yapay zekâ işleme onay metninin sürümü
AI_CONSENT_VERSION=2026-10-25

# Giriş yolları (docs/adr/0012). Hepsi kapalı başlar; GET /v1/app-config
# uygulamaya hangilerinin açık olduğunu söyler. Değerler yalnız sunucu
# .env'inde durur, depoya girmez.
# AUTH_APPLE_ENABLED=false
# APPLE_BUNDLE_ID=com.everbloom.care
# Sign in with Apple anahtarı (.p8): hesap silmede erişimi iptal etmek için zorunlu
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# AUTH_GOOGLE_ENABLED=false (üretimde Apple da açık olmalı, App Store 4.8)
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
# AUTH_PHONE_ENABLED=false (yalnız +90; SMS_DRIVER=netgsm ile)
# Telefon numarasının özeti için anahtar (en az 32 karakter)
# PHONE_PEPPER=
# PHONE_CODES_PER_NUMBER_PER_DAY=5
# PHONE_CODES_PER_DAY=1000
# Android SMS Retriever: uygulamanın 11 karakterlik özeti, SMS'in son satırı
# SMS_RETRIEVER_HASH=
# Apple yenileme jetonlarını şifreleyen anahtar (32 bayt, base64)
# TOKEN_ENCRYPTION_KEY=
# Bu sürümden eski uygulamalar güncelleme ekranına gider
# MIN_APP_VERSION=1.0.0
# Kayıttan sonra bir kez üyelik ekranı
# PAYWALL_ONBOARDING=true
